# Copy to `.env` and adjust. `.env` is git-ignored; this template is not.
# Every DEVSECOPS_* key maps 1:1 to a field on `Settings` in main.py.
# Leave a value blank to keep the built-in default. The service runs with an
# empty `.env` - LLM, webhook and persistence are all opt-in.

# ── Runtime ────────────────────────────────────────────────────────────────
DEVSECOPS_ENVIRONMENT=development          # development | staging | production | test
DEVSECOPS_DEBUG=false
DEVSECOPS_LOG_LEVEL=INFO
DEVSECOPS_LOG_JSON=true
DEVSECOPS_SERVE_DASHBOARD=true

# ── HTTP / CORS / limits ─────────────────────────────────────────────────
# JSON array of EXACT browser origins allowed to call the API.
DEVSECOPS_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5500","http://localhost:8080"]
DEVSECOPS_CORS_ALLOW_CREDENTIALS=false
DEVSECOPS_MAX_REQUEST_BODY_BYTES=2097152

# ── Pipeline tuning ─────────────────────────────────────────────────────
DEVSECOPS_AGENT_TIMEOUT_SECONDS=20
DEVSECOPS_REMEDIATION_AGENT_TIMEOUT_SECONDS=75
DEVSECOPS_PIPELINE_TIMEOUT_SECONDS=90
DEVSECOPS_MAX_CONCURRENT_PIPELINES=16
DEVSECOPS_SECRET_ENTROPY_THRESHOLD=4.0
DEVSECOPS_SSE_KEEPALIVE_SECONDS=15
DEVSECOPS_LLM_MAX_CATEGORIES=6

# ── Analysis history (optional SQLite persistence) ────────────────────
# When false: /api/v1/analyses returns empty, /report returns 404, the core
# pipeline is unaffected.
DEVSECOPS_PERSISTENCE_ENABLED=false
DEVSECOPS_DATABASE_PATH=./data/analyses.db

# ── AI-assisted remediation (optional) ───────────────────────────────
# provider = null disables live model calls; the deterministic template engine
# is always the fallback, so the service runs fully without any key. Every
# patch - LLM or template - is re-scanned before the engine reports a verdict.
DEVSECOPS_LLM_PROVIDER=null                # null | anthropic | openai
DEVSECOPS_LLM_MODEL=                       # openai: blank -> gpt-4o-mini; anthropic: REQUIRED (set the model id)
DEVSECOPS_LLM_BASE_URL=                    # blank -> provider default (https only)
DEVSECOPS_LLM_API_KEY=                     # or use the provider-native var below
DEVSECOPS_LLM_TIMEOUT_SECONDS=25
DEVSECOPS_LLM_MAX_OUTPUT_TOKENS=1024
DEVSECOPS_LLM_MAX_ATTEMPTS=2
# Provider-native fallbacks (NOT prefixed) - read only if DEVSECOPS_LLM_API_KEY is unset:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── GitHub webhook (Phase 2) ──────────────────────────────────────────
# Unset DEVSECOPS_GITHUB_WEBHOOK_SECRET => POST /api/v1/webhook returns 503.
DEVSECOPS_GITHUB_WEBHOOK_SECRET=
DEVSECOPS_GITHUB_API_BASE=https://api.github.com
DEVSECOPS_GITHUB_RAW_BASE=https://raw.githubusercontent.com
DEVSECOPS_GITHUB_TOKEN=                    # optional: private repos / rate limits
DEVSECOPS_WEBHOOK_MAX_FILES=25
DEVSECOPS_MAX_WEBHOOK_BODY_BYTES=1048576
DEVSECOPS_WEBHOOK_ALLOWED_REPOS=[]         # e.g. ["octocat/hello-world"]; [] = any HMAC-valid repo
DEVSECOPS_HTTP_TIMEOUT_SECONDS=15

# ── Uvicorn entrypoint (only read by `python main.py`) ────────────────
HOST=127.0.0.1
PORT=8000
